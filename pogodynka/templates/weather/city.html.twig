{% extends 'base.html.twig' %}
{# @var place \App\Entity\Place #}
{# @var forecasts \App\Entity\Forecast[] #}
{% block title %}Hello WeatherController!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Weather in {{ place.name}} {{ place.country }}</h1>

    <ul>
        {% for forecast in forecasts %}
            <li>
                {{ forecast.date|date('d.m.Y') }}:
                {{ forecast.temperature }}&deg;C
            </li>
        {% else %}
            <li>Brak prognoz pogody.</li>
        {% endfor %}
    </ul>
</div>
{% endblock %}
